#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <physical_layouts.dtsi>
#include "keypos_34keys.h"

#define _BASE    0
#define _NAV     1
#define _SYM     2
#define _BTF     3

#define RGB_BASE RGB_COLOR_HSB(0,100,7)
#define RGB_SYM RGB_COLOR_HSB(20,100,5)
#define RGB_NAV RGB_COLOR_HSB(10,100,8)
#define RGB_BTF RGB_COLOR_HSB(250,100,8)

/ {
    dual_1u_layout: dual_1u_layout {
        compatible = "zmk,physical-layout";
        display-name = "Dual 1u space";
        transform = <&dual_1u_transform>;
        kscan = <&kscan0>;

                keys  //             w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   40    1200   250   140>
            , <&key_physical_attrs 100 100  100   20    1200   250   140>
            , <&key_physical_attrs 100 100  200    0    1200   250   140>
            , <&key_physical_attrs 100 100  300   20    1200   250   140>
            , <&key_physical_attrs 100 100  400   40    1200   250   140>
            , <&key_physical_attrs 100 100  530   40  (-1200)  780   140>
            , <&key_physical_attrs 100 100  630   20  (-1200)  780   140>
            , <&key_physical_attrs 100 100  730    0  (-1200)  780   140>
            , <&key_physical_attrs 100 100  830   20  (-1200)  780   140>
            , <&key_physical_attrs 100 100  930   40  (-1200)  780   140>
            , <&key_physical_attrs 100 100    0  140    1200   250   140>
            , <&key_physical_attrs 100 100  100  120    1200   250   140>
            , <&key_physical_attrs 100 100  200  100    1200   250   140>
            , <&key_physical_attrs 100 100  300  120    1200   250   140>
            , <&key_physical_attrs 100 100  400  140    1200   250   140>
            , <&key_physical_attrs 100 100  530  140  (-1200)  780   140>
            , <&key_physical_attrs 100 100  630  120  (-1200)  780   140>
            , <&key_physical_attrs 100 100  730  100  (-1200)  780   140>
            , <&key_physical_attrs 100 100  830  120  (-1200)  780   140>
            , <&key_physical_attrs 100 100  930  140  (-1200)  780   140>
            , <&key_physical_attrs 100 100    0  240    1200   250   140>
            , <&key_physical_attrs 100 100  100  220    1200   250   140>
            , <&key_physical_attrs 100 100  200  200    1200   250   140>
            , <&key_physical_attrs 100 100  300  220    1200   250   140>
            , <&key_physical_attrs 100 100  400  240    1200   250   140>
            , <&key_physical_attrs 100 100  530  240  (-1200)  780   140>
            , <&key_physical_attrs 100 100  630  220  (-1200)  780   140>
            , <&key_physical_attrs 100 100  730  200  (-1200)  780   140>
            , <&key_physical_attrs 100 100  830  220  (-1200)  780   140>
            , <&key_physical_attrs 100 100  930  240  (-1200)  780   140>
            , <&key_physical_attrs 100 100  315  400    1500   415   400>
            , <&key_physical_attrs 100 100  415  400       0     0     0>
            , <&key_physical_attrs 100 100  515  400       0     0     0>
            , <&key_physical_attrs 100 100  615  400  (-1500)  615   400>
            ;

    };

// ------------------------- MACROS --------------------------------
    macros {
        to_BASE: to_BASE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&rgb_ug RGB_BASE>
                , <&tog _NAV>
                ;
        };

        to_NAV: to_NAV {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&rgb_ug RGB_NAV>
                , <&tog _NAV>
                ;
        };

        mo_BTF: mo_BTF {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_BTF>
                , <&macro_press &mo _BTF>
                , <&macro_pause_for_release>
                , <&macro_tap &rgb_ug RGB_BASE>
                , <&macro_release &mo _BTF>
                ;
        };

        to_BOOT: to_BOOT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_COLOR_HSB(0,100,100)>
                , <&rgb_ug RGB_ON>
                , <&bootloader>
                ;
        };

        mlc_ou: macro_lc_ou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp O>
                , <&kp U>
                ;
        };

        mlc_qu: macro_lc_qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp Q>
                , <&kp U>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";
// ------------------------- LAYER COMBOS --------------------------------
        combo_BOOT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMC RMC>;
            bindings = <&to_BOOT>;
            layers = <_BTF>;
        };

        combo_BTF {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LHO RHO>;
            bindings = <&mo_BTF>;
        };

// ------------------------- MODS COMBOS --------------------------------
        combo_CAPS {
            timeout-ms = <50>;
            key-positions = <LTI RTI>;
            bindings = <&caps_word>;
            require-prior-idle-ms = <200>;
            layers = <_BASE>;
        };

// ------------------------- CHARACTER COMBOS --------------------------------
        combo_OU {
            timeout-ms = <300>;
            key-positions = <RTM RTR>;
            bindings = <&mlc_ou>;
            layers = <_BASE>;
        };

        combo_QU {
            timeout-ms = <300>;
            key-positions = <RBM RBI>;
            bindings = <&mlc_qu>;
            layers = <_BASE>;
        };

// ------------------------- SYMBOL COMBOS --------------------------------
        combo_LPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LHO LMI>;
            bindings = <&kp LPAR>;
            layers = <_BASE _SYM>;
        };

        combo_RPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMI RHO>;
            bindings = <&kp RPAR>;
            layers = <_BASE _SYM>;
        };

        combo_LBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMM LHO>;
            bindings = <&kp LBRC>;
            layers = <_BASE _SYM>;
        };

        combo_RBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMM RHO>;
            bindings = <&kp RBRC>;
            layers = <_BASE _SYM>;
        };

        combo_LBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMR LHO>;
            bindings = <&kp LBKT>;
            layers = <_BASE _SYM>;
        };

        combo_RBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMR RHO>;
            bindings = <&kp RBKT>;
            layers = <_BASE _SYM>;
        };

        combo_GT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMP RHO>;
            bindings = <&kp GT>;
            layers = <_BASE _SYM>;
        };

        combo_LT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMP LHO>;
            bindings = <&kp LT>;
            layers = <_BASE _SYM>;
        };
    };

    behaviors {
// ------------------------- TAP-DANCES --------------------------------
        win_cp: win_cp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LC(V)>, <&kp LC(C)>, <&kp LC(X)>;
        };

        mac_cp: mac_cp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LG(V)>, <&kp LG(C)>, <&kp LG(X)>;
        };

// ------------------------- HOLD-TAPS --------------------------------
        /* left-hand HRMs */
        hml: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        /* right-hand HRMs */
        hmr: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        rml: akr_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&ak_r>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        asl: aks_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&ak_d>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsl: hrs_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsr: hrs_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        bst: backspace-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            //require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        spt: space-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            //require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

// ----------------------- ADAPTIVE-KEYS ------------------------------- 
        ak_d: ak_d {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp D>;

            akt_th { trigger-keys = <T>; max-prior-idle-ms = <250>; bindings = <&kp H>; };
            akt_ch { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_wh { trigger-keys = <W>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_sh { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_gh { trigger-keys = <G>; max-prior-idle-ms = <300>; bindings = <&kp H>; };

            akt_bn { trigger-keys = <B>; max-prior-idle-ms = <300>; bindings = <&kp N>; };
        };

        ak_b: ak_b {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp B>;

            akt_sc { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp C>; };
            akt_ph { trigger-keys = <P>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
        };

        ak_r: ak_r {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp R>;

            akt_ng { trigger-keys = <N>; max-prior-idle-ms = <300>; bindings = <&kp G>; };
        };

        ak_p: ak_p {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp P>;

            akt_tv { trigger-keys = <T>; max-prior-idle-ms = <300>; bindings = <&kp V>; };
            akt_br { trigger-keys = <B>; max-prior-idle-ms = <300>; bindings = <&kp R>; };
            akt_cr { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&kp R>; };
        };

        ak_y: ak_y {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp Y>;

            akt_ue { trigger-keys = <U>; max-prior-idle-ms = <300>; bindings = <&kp E>; };
        };

// ------------------------- MOD-MORPHS --------------------------------
        // mm_you: mm_you {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_you>, <&muc_you>;
        //     mods = <(MOD_LSFT)>;
        // };

        // mm_the: mm_the {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_the>, <&muc_the>;
        //     mods = <(MOD_LSFT)>;
        // };

    };

    keymap {
        compatible = "zmk,keymap";

                base_layer {
// -------------------------------    -------------------------------
// |  B  |  L  |  M  |  P  |  F  |    |  W  |  C  |  O  |  U  |  Y  |
// |  N  |  R  |  T  |  D  |  H  |    |  G  |  S  |  A  |  E  |  I  |
// | wCP |  J  |  V  |  K  |  <  |    |  >  |  Z  |  X  |  Q  | mCP |
//            | _SYM(BSPC) |  =  |    |  +  | _NAV(SPC) |
                        bindings = <
   &ak_b        &kp L        &kp M       &ak_p        &kp F       &kp W  &kp C        &kp O       &kp U        &ak_y
   &hml LALT N  &rml LCTRL R &hml LGUI T &asl LSHFT D &kp H       &kp G  &hsr LSHFT S &hmr LGUI A &hmr LCTRL E &hmr LALT I
   &win_cp      &kp J        &kp V       &kp K        &kp LT      &kp GT &kp Z        &kp X       &kp Q        &mac_cp
                             &bst _SYM BSPC  &bst _NAV EQUAL      &spt _SYM PLUS  &spt _NAV SPACE
                        >;
                };

                nav_layer {
// -------------------------------    ----------------------------------
// |  8  |  7  |  6  |  5  | INS |    | pUP | HOME |  UP  | END  | ESC |
// |  4  |  3  |  2  |  1  | PSC |    | pDN | LEFT | SPC  | RGHT | RET |
// | clc | , . |  9  |  0  |  b- |    |  b+ | TAB  | DOWN | DEL  | APP |
//            | _SYM(BSPC) |     |    |     | SHFT |
                        bindings = <
   &kp N8        &kp N7        &kp N6       &kp N5        &kp INS         &kp PG_UP    &kp HOME        &kp UP          &kp END          &kp ESC
   &hml LALT N4  &hml LCTRL N3 &hml LGUI N2 &hsl LSHFT N1 &kp PSCRN       &kp PG_DN    &hsr LSHFT LEFT &hmr LGUI SPACE &hmr LCTRL RIGHT &hmr LALT RET
   &kp C_AL_CALC &kp KP_DOT    &kp N9       &kp N0        &kp C_BRI_DN    &kp C_BRI_UP &kp TAB         &kp DOWN        &kp DEL          &kp K_APP
                                           &bst _SYM BSPC &none           &none  &kp LSHFT
                        >;
                };
                
                sym_layer {
// -------------------------------    -------------------------------
// |  \  |  |  |  _  |  =  |  {  |    |  }  |  "  |  ;  |  :  |  !  |
// |  /  |  *  |  -  |  +  |  (  |    |  )  |  '  |  ,  |  .  |  ?  |
// |  `  |  &  |  ^  |  %  |  [  |    |  ]  |  @  |  #  |  $  |  ~  |
//                  | BSPC |     |    |     | _NAV(SPC) |
                        bindings = <
   &kp BSLH        &kp PIPE        &kp UNDER       &kp EQUAL       &kp LBRC      &kp RBRC &kp DQT        &kp SEMI        &kp COLON      &kp EXCL
   &hml LALT SLASH &hml LCTRL STAR &hml LGUI MINUS &hsl LSHFT PLUS &kp LPAR      &kp RPAR &hsr LSHFT SQT &hmr LGUI COMMA &hmr LCTRL DOT &hmr LALT QMARK
   &kp GRAVE       &kp AMPS        &kp CARET       &kp PRCNT       &kp LBKT      &kp RBKT &kp AT         &kp HASH        &kp DLLR       &kp TILDE
                                                         &kp BSPC  &none         &none   &spt _NAV SPACE
                        >;
                };
                
                btf_layer {
// -------------------------------    -----------------------------
// | BT1 | BT2 | BT3 | BT4 | BT5 |    |    | F1 | F2  | F3  | F4  |    
// | ALT | CTL | GUI | SFT | USB |    |    | F5 | F6  | F7  | F8  |
// | CLR |  v. |  v- |  v+ | RGB |    |    | F9 | F10 | F11 | F12 |
//                   |     |     |    |    |     |
                        bindings = <
   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4       &none  &kp F1  &kp F2  &kp F3  &kp F4       
   &kp LALT     &kp LCTRL    &kp LGUI     &kp LSHFT    &out OUT_TOG       &none  &kp F5  &kp F6  &kp F7  &kp F8     
   &bt BT_CLR   &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &rgb_ug RGB_TOG    &none  &kp F9  &kp F10 &kp F11 &kp F12
                                                    &none   &none         &none  &none
                        >;
                };       

                extra1 {
                        status = "reserved";
                };

                extra2 {
                        status = "reserved";
                };         
    };

    chosen {
        
        zmk,physical-layout = &dual_1u_layout;

        /delete-property/  zmk,kscan;
        /delete-property/  zmk,matrix-transform;
    };
};
